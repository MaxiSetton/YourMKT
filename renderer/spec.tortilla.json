{
  "id": "tortilla-001",
  "arquetipo": "promo",
  "formato": "reel",
  "aspect": "9:16",
  "fps": 30,
  "duracion_seg": 17,

  "marca": {
    "nombre": "Doña Rosa",
    "colores": {
      "primario": "#7A1F1F",
      "secundario": "#2E4034",
      "acento": "#E8C66A",
      "fondo": "#F4E9D8",
      "texto": "#2B1B14",
      "textoInverso": "#F4E9D8"
    },
    "fuenteTitulo": "Fraunces, Georgia, serif",
    "fuenteTexto": "Montserrat, system-ui, sans-serif"
  },

  "escenas": [
    {
      "id": "hook",
      "rol": "hook",
      "t_in": 0,
      "t_out": 4.3,
      "scrim": "bottom",
      "visual": {
        "intencion": "la tortilla recien hecha, apetitosa, mientras se dice la oferta",
        "fuentes": [
          { "tipo": "asset_cliente", "archivo": "video-hero-tortilla.mp4", "match": { "categoria": "producto", "palabras": ["tortilla"] } },
          { "tipo": "kenburns", "archivo": "tortilla.jpg" }
        ]
      },
      "overlays": [{ "componente": "BrandTag", "props": { "nombre": "Doña Rosa", "lugar": "Villa Crespo" } }]
    },
    {
      "id": "presenta",
      "rol": "producto",
      "t_in": 4.3,
      "t_out": 7.6,
      "scrim": "bottom",
      "visual": {
        "intencion": "plano amplio de la tortilla en la tabla",
        "fuentes": [{ "tipo": "kenburns", "archivo": "tortilla.jpg" }]
      },
      "overlays": []
    },
    {
      "id": "baba",
      "rol": "producto",
      "t_in": 7.6,
      "t_out": 10.4,
      "scrim": "bottom",
      "visual": {
        "intencion": "macro del interior jugoso al abrir",
        "fuentes": [
          { "tipo": "imagen_generada", "archivo": "video-baba.mp4", "prompt": "tortilla cut open, juicy center" },
          { "tipo": "kenburns", "archivo": "tortilla.jpg" }
        ]
      },
      "overlays": []
    },
    {
      "id": "ambiente",
      "rol": "contexto",
      "t_in": 10.4,
      "t_out": 13.6,
      "scrim": "bottom",
      "visual": {
        "intencion": "video del salon lleno (lo sube el cliente) - PLACEHOLDER por ahora",
        "fuentes": [
          { "tipo": "asset_cliente", "archivo": "salon.mp4", "match": { "categoria": "otro", "palabras": ["salon", "local"] } }
        ]
      },
      "overlays": []
    },
    {
      "id": "cta",
      "rol": "cta",
      "t_in": 13.6,
      "t_out": 17,
      "scrim": "full",
      "ocultarSubtitulos": true,
      "visual": {
        "intencion": "cierre apetitoso de marca",
        "fuentes": [{ "tipo": "kenburns", "archivo": "tortilla.jpg" }]
      },
      "overlays": [{ "componente": "CTA", "props": { "accento": "te esperamos", "titulo": "Reservá por DM", "sub": "@donarosa.cantina" } }]
    }
  ],

  "audio": {
    "modo": "propio",
    "voz": {
      "texto": "¿Primera vez en Doña Rosa? ¡La copa de vino va de regalo! Probá la tortilla de papa como la de la abuela: doradita por fuera, jugosa por dentro. Te esperamos acá, en Villa Crespo. ¡Reservá por mensaje!",
      "voz_tts": "es-AR-ElenaNeural"
    },
    "musica": { "src": "music.mp3", "volumen": 0.32 }
  },

  "subtitulos": { "auto": true, "estilo": "marcador", "maxPalabras": 4 },
  "copy": {
    "caption": "Tortilla de papa como la de antes. Papa, huevo y tiempo, nada raro. Doradita por fuera, jugosa en el medio. Si todavía no caíste por Doña Rosa, esta es la excusa 🥔🍳 Primera vez: la copa de vino natural va de regalo. Reservá por DM. Villa Crespo, te esperamos.",
    "hashtags": ["#tortilladepapa", "#comidacasera", "#villacrespo", "#bodegon", "#buenosairesfood"]
  }
}
