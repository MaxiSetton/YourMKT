{
  "id": "tutorial-001",
  "arquetipo": "tutorial",
  "formato": "reel",
  "aspect": "9:16",
  "fps": 30,
  "duracion_seg": 19,

  "marca": {
    "nombre": "Cafarela",
    "colores": {
      "primario": "#5B3A29",
      "secundario": "#8A5A3B",
      "acento": "#E8B04B",
      "fondo": "#FBF3E7",
      "texto": "#2B1B12",
      "textoInverso": "#FBF3E7"
    },
    "fuenteTitulo": "Georgia, 'Times New Roman', serif",
    "fuenteTexto": "system-ui, -apple-system, sans-serif"
  },

  "escenas": [
    {
      "id": "hook",
      "rol": "hook",
      "t_in": 0,
      "t_out": 3,
      "scrim": "full",
      "visual": {
        "intencion": "plano que invite a quedarse a ver el paso a paso",
        "fuentes": [
          { "tipo": "asset_cliente", "match": { "categoria": "proceso", "palabras": ["preparacion", "barra"] } },
          { "tipo": "kenburns", "archivo": "bg-intro.jpg" }
        ]
      },
      "overlays": [{ "componente": "TituloIntro", "props": { "kicker": "PASO A PASO", "titulo": "Spanish Latte en casa" } }]
    },
    {
      "id": "paso1",
      "rol": "paso",
      "t_in": 3,
      "t_out": 8,
      "scrim": "top",
      "visual": {
        "intencion": "mostrar el espresso saliendo / cargado",
        "fuentes": [
          { "tipo": "asset_cliente", "archivo": "paso1.mp4", "match": { "categoria": "proceso", "palabras": ["espresso", "maquina"] } },
          { "tipo": "kenburns", "archivo": "bg-intro.jpg" }
        ]
      },
      "overlays": [{ "componente": "PasoBadge", "props": { "numero": 1, "titulo": "Espresso cargado", "detalle": "Doble shot, bien intenso, recien hecho." } }]
    },
    {
      "id": "paso2",
      "rol": "paso",
      "t_in": 8,
      "t_out": 13,
      "scrim": "top",
      "visual": {
        "intencion": "agregar la leche condensada",
        "fuentes": [
          { "tipo": "asset_cliente", "archivo": "paso2.mp4", "match": { "categoria": "proceso", "palabras": ["leche", "condensada"] } },
          { "tipo": "kenburns", "archivo": "bg-cta.jpg" }
        ]
      },
      "overlays": [{ "componente": "PasoBadge", "props": { "numero": 2, "titulo": "Leche condensada", "detalle": "Una cucharada al gusto, revolves y listo." } }]
    },
    {
      "id": "paso3",
      "rol": "paso",
      "t_in": 13,
      "t_out": 15.5,
      "scrim": "top",
      "visual": {
        "intencion": "el resultado servido, apetitoso",
        "fuentes": [
          { "tipo": "asset_cliente", "archivo": "paso3.mp4", "match": { "categoria": "producto", "palabras": ["servido", "vaso", "hielo"] } },
          { "tipo": "kenburns", "archivo": "bg-intro.jpg" }
        ]
      },
      "overlays": [{ "componente": "PasoBadge", "props": { "numero": 3, "titulo": "Hielo y a disfrutar", "detalle": "Sobre hielo queda espectacular." } }]
    },
    {
      "id": "cta",
      "rol": "cta",
      "t_in": 15.5,
      "t_out": 19,
      "scrim": "full",
      "visual": {
        "intencion": "cierre de marca",
        "fuentes": [{ "tipo": "imagen_generada", "archivo": "bg-cta.jpg", "prompt": "cozy cafe interior golden hour" }]
      },
      "overlays": [{ "componente": "CTA", "props": { "titulo": "Etiquetanos", "sub": "@cafarela · mostranos el tuyo" } }]
    }
  ],

  "audio": {
    "modo": "propio",
    "voz": {
      "texto": "Spanish Latte en casa, en tres pasos. Uno: un espresso doble bien cargado. Dos: una cucharada de leche condensada al gusto y revolves. Tres: lo servis sobre hielo y listo. Etiquetanos cuando lo hagas.",
      "voz_tts": "es-AR-ElenaNeural"
    },
    "musica": { "src": "music.mp3", "volumen": 0.16 }
  },

  "subtitulos": { "auto": true, "estilo": "bloque", "maxPalabras": 4 },
  "copy": {
    "caption": "Spanish Latte en casa en 3 pasos ☕ Guardalo para probarlo el finde.",
    "hashtags": ["#cafe", "#recetas", "#spanishlatte", "#coffeeathome"]
  }
}
