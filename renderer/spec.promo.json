{
  "id": "promo-001",
  "arquetipo": "promo",
  "formato": "reel",
  "aspect": "9:16",
  "fps": 30,
  "duracion_seg": 18,

  "marca": {
    "nombre": "Cafarela",
    "colores": {
      "primario": "#5B3A29",
      "secundario": "#8A5A3B",
      "acento": "#E8B04B",
      "fondo": "#FBF3E7",
      "texto": "#2B1B12",
      "textoInverso": "#FBF3E7"
    },
    "fuenteTitulo": "Georgia, 'Times New Roman', serif",
    "fuenteTexto": "system-ui, -apple-system, sans-serif"
  },

  "escenas": [
    {
      "id": "hook",
      "rol": "hook",
      "t_in": 0,
      "t_out": 3,
      "scrim": "bottom",
      "visual": {
        "intencion": "ambiente cafe calido, apetitoso, que enganche",
        "fuentes": [
          { "tipo": "asset_cliente", "match": { "categoria": "producto", "palabras": ["cafe", "latte", "barra"] } },
          { "tipo": "kenburns", "archivo": "bg-intro.jpg", "prompt": "cinematic close-up spanish latte, warm light, steam" }
        ]
      },
      "overlays": [{ "componente": "TituloIntro", "props": { "kicker": "NUEVO", "titulo": "Spanish Latte" } }]
    },
    {
      "id": "producto",
      "rol": "producto",
      "t_in": 3,
      "t_out": 9,
      "scrim": "bottom",
      "visual": {
        "intencion": "primer plano del producto estrella en accion",
        "fuentes": [
          { "tipo": "asset_cliente", "archivo": "clip_pour.mp4", "match": { "categoria": "producto", "palabras": ["sirviendo", "latte", "taza"] } },
          { "tipo": "video_generado", "base": "asset_cliente", "prompt_movimiento": "slow push-in, steam rising softly" },
          { "tipo": "kenburns", "archivo": "bg-intro.jpg" }
        ]
      },
      "overlays": [{ "componente": "LowerThird", "props": { "texto": "Espresso + leche condensada", "sub": "cremoso y dulce en su punto" } }]
    },
    {
      "id": "beneficios",
      "rol": "beneficios",
      "t_in": 9,
      "t_out": 13.5,
      "scrim": "full",
      "visual": {
        "intencion": "fondo calido que no compita con el texto",
        "fuentes": [
          { "tipo": "kenburns", "archivo": "bg-cta.jpg", "prompt": "cozy cafe interior, warm bokeh" }
        ]
      },
      "overlays": [
        { "componente": "ListaBeneficios", "props": { "titulo": "Por que te va a gustar", "items": ["Espresso de especialidad", "Dulzor justo, sin empalagar", "Listo en 2 minutos"] } }
      ]
    },
    {
      "id": "cta",
      "rol": "cta",
      "t_in": 13.5,
      "t_out": 18,
      "scrim": "full",
      "visual": {
        "intencion": "imagen aspiracional del local para cerrar",
        "fuentes": [
          { "tipo": "imagen_generada", "archivo": "bg-cta.jpg", "base": "referencia_marca", "prompt": "warm inviting cafe interior golden hour" }
        ]
      },
      "overlays": [{ "componente": "CTA", "props": { "titulo": "Te esperamos", "sub": "Av. Siempreviva 742 · todos los dias" } }]
    }
  ],

  "audio": {
    "modo": "propio",
    "voz": {
      "texto": "Llego el nuevo Spanish Latte. Espresso de especialidad con leche condensada, cremoso y con el dulzor justo. Listo en dos minutos. Veni a probarlo esta semana, te esperamos.",
      "voz_tts": "es-AR-ElenaNeural"
    },
    "musica": { "src": "music.mp3", "volumen": 0.16 }
  },

  "subtitulos": { "auto": true, "estilo": "bloque", "maxPalabras": 4 },
  "copy": {
    "caption": "Nuevo Spanish Latte ☕✨ Espresso + leche condensada, el dulce justo. Te esperamos esta semana.",
    "hashtags": ["#cafe", "#spanishlatte", "#cafeteria", "#specialtycoffee"]
  }
}
